# 自身忽略（本地 gitignore 配置，不纳入版本控制）
.gitignore

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# 本地虚拟环境
.venv/
.vscode/
.tmp/
# Trae IDE 对话历史记录（本地开发日志，无需纳入版本控制）
.waylog/
# Local secrets
.env
# 本地配置文件覆盖（含敏感信息，不纳入版本控制）
*.local.*
*.secret.*
*.override.*
config.local.*

# Markdown 文档（保留已跟踪的 README 和审计报告）
*.md
!README.md
!CODE_AUDIT.md
!outputs/README.md
!outputs/us_trend_alerts/README.md
!processed_data/README.md
!research/README.md

# 回测生成输出

docs/
examples/
!examples/
!examples/__init__.py
!examples/download_mt5_data.py
outputs/
!outputs/
outputs/*
!outputs/README.md
!outputs/us_trend_alerts/
outputs/us_trend_alerts/*
!outputs/us_trend_alerts/README.md
research/
!research/
research/*
!research/README.md
!research/__init__.py
!research/d1_suite/
research/d1_suite/*
!research/d1_suite/__init__.py
!research/d1_suite/scripts/
!research/d1_suite/scripts/*.py
!research/strategy_variants/
research/strategy_variants/*
!research/strategy_variants/__init__.py
!research/strategy_variants/scripts/
!research/strategy_variants/scripts/*.py
processed_data/
!processed_data/
processed_data/*
!processed_data/README.md