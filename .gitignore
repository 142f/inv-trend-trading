# 自身忽略（本地 gitignore 配置，不纳入版本控制）
.gitignore

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# 本地虚拟环境及IDE
.venv/
.vscode/
.tmp/
.waylog/

# 本地敏感配置
.env
*.local.*
*.secret.*
*.override.*
config.local.*

# 文档（仅保留根目录和特定子目录的 README 等）
*.md
!README.md
!CODE_AUDIT.md
!outputs/README.md
!outputs/us_trend_alerts/README.md
!processed_data/README.md
!research/README.md

# 测试目录（完全忽略）
tests/
test-temp/

# 示例目录（仅保留指定文件）
examples/
!examples/__init__.py
!examples/download_mt5_data.py

# 输出目录（忽略所有文件，保留目录结构和 README）
outputs/
!outputs/
outputs/*
!outputs/README.md
!outputs/us_trend_alerts/
outputs/us_trend_alerts/*
!outputs/us_trend_alerts/README.md

# 研究目录（忽略所有文件，保留目录结构和特定脚本）
research/
!research/
research/*
!research/README.md
!research/__init__.py
!research/d1_suite/
research/d1_suite/*
!research/d1_suite/__init__.py
!research/d1_suite/scripts/
!research/d1_suite/scripts/*.py
!research/strategy_variants/
research/strategy_variants/*
!research/strategy_variants/__init__.py
!research/strategy_variants/scripts/
!research/strategy_variants/scripts/*.py

# 处理数据目录（忽略所有文件，保留 README）
processed_data/
!processed_data/
processed_data/*
!processed_data/README.md