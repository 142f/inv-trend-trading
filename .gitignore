# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
/pytest-cache-files-*/
/tf/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and packaging output
.venv/
venv/
env/
build/
dist/
*.egg-info/
.ipynb_checkpoints/
# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
# Local secrets and machine-specific overrides
.env
.env.*
!.env.example
*.local.*
*.secret.*
*.override.*
config.local.*

# Runtime market-data lake and generated outputs
/data/*
!/data/README.md
processed_data/*
!processed_data/README.md
logs/
重构验证/
重构验证 忽略/
# Research source and analysis documents are versioned; generated backtest
# result trees are not release inputs.
/research/**/outputs/

# Local-only progress notes and generated acceptance snapshots
/artifacts/WORK_PROGRESS.md
/artifacts/refactor-acceptance-s1-s5/
/artifacts/数据管理流水线任务看板_v1.html

# Temporary delivery and local test directories
.tmp/
test-temp/
/.test-temp-*/
.screenshots/

deliverables/*
!deliverables/README.md
outputs/*
!outputs/README.md

# docs/, tests/, and scripts/ stay tracked.
